pragma circom 2.1.6;

include "../../node_modules/circomlib/circuits/comparators.circom";
include "fixedpoint.circom";

/*
 * Piecewise-linear sigmoid.
 *
 * The protocol does not approximate the logistic function -- it *defines* its
 * activation to be the piecewise-linear function below, so that the circuit,
 * the Python trainer and every verifier agree exactly.  Fidelity to the true
 * logistic curve is then a modelling question, not a soundness one:
 *
 *     max |sigma_pwl(z) - sigma(z)|  =  0.0116  over z in [-12, 12]
 *
 * Construction.  sigma is odd about (0, 1/2), so we evaluate on a = |z| and
 * reflect:  sigma(z) = 1 - sigma(|z|) for z < 0.  On a the curve is broken at
 * a in {1, 2, 3, 5} and chorded between the true sigmoid values, saturating at
 * sigma(5) = 0.993307 -- the saturation value is the chord endpoint rather
 * than 1 so the function stays continuous.
 *
 * Cost: 5 comparators (1 sign + 4 breakpoints), 2 multiplications and one
 * constant division -- roughly 190 constraints at zBits = 33.
 *
 * The constants are generated by scripts/gen_activation_constants.py and
 * mirrored in zkfl/fixedpoint.py; changing one without the other breaks
 * proving, and tests/test_fixedpoint.py fails loudly if they drift.
 */
template PWLSigmoid(zBits, SCALE) {
    signal input z;          // scaled by SCALE, |z| < 2^zBits
    signal output out;       // scaled by SCALE, in [0, SCALE]

    var NPIECES = 5;

    // Breakpoints on |z|, scaled.
    var T[5] = [0, 1000000, 2000000, 3000000, 5000000];
    // sigma at each breakpoint, scaled.
    var C[5] = [500000, 731059, 880797, 952574, 993307];
    // Chord slopes, scaled.  The last piece is flat (saturation).
    var M[5] = [231059, 149738, 71777, 20367, 0];

    // ---- |z| and its sign -------------------------------------------------
    component abs = BoundedAbs(zBits);
    abs.in <== z;
    signal a;
    a <== abs.out;

    // ---- piece selection --------------------------------------------------
    // less[i] = 1 iff a < T[i+1].  These are monotone, so the differences
    // below form a one-hot selector without any extra constraint.
    component less[4];
    for (var i = 0; i < 4; i++) {
        less[i] = LessThan(zBits);
        less[i].in[0] <== a;
        less[i].in[1] <== T[i + 1];
    }

    signal sel[5];
    sel[0] <== less[0].out;
    sel[1] <== less[1].out - less[0].out;
    sel[2] <== less[2].out - less[1].out;
    sel[3] <== less[3].out - less[2].out;
    sel[4] <== 1 - less[3].out;

    // ---- the selected line ------------------------------------------------
    // Constant coefficients, so these three are linear combinations and cost
    // nothing.
    var mAcc = 0;
    var cAcc = 0;
    var tAcc = 0;
    signal mSel;
    signal cSel;
    signal tSel;
    mSel <== sel[0]*M[0] + sel[1]*M[1] + sel[2]*M[2] + sel[3]*M[3] + sel[4]*M[4];
    cSel <== sel[0]*C[0] + sel[1]*C[1] + sel[2]*C[2] + sel[3]*C[3] + sel[4]*C[4];
    tSel <== sel[0]*T[0] + sel[1]*T[1] + sel[2]*T[2] + sel[3]*T[3] + sel[4]*T[4];

    // slope * (a - anchor) has scale SCALE^2; one constant division brings it
    // back to SCALE.  On the flat piece mSel = 0, so the unbounded (a - tSel)
    // there cannot blow the range.
    signal prod;
    prod <== mSel * (a - tSel);

    // DivConst below pins down a unique (q, r) only while |prod| <= SCALE *
    // 2^24.  The bound on prod comes from the table, not from zBits: on the
    // flat piece mSel = 0, and on every other piece |a - tSel| < T[4].  That
    // holds for the honest witness because the selector is determined by a --
    // but uniqueness has to hold for *every* witness, so we constrain it here
    // instead of arguing it in prose.  M[0]*T[4] = 1.155e12, comfortably under
    // SCALE * 2^24 = 1.678e13.
    var PROD_MAX = M[0] * T[4];
    component prodBound = AbsBound(42, PROD_MAX);
    prodBound.in <== prod;

    component scaleDown = DivConst(SCALE, 20, 24);
    scaleDown.num <== prod;

    signal sigAbs;
    sigAbs <== cSel + scaleDown.q;

    // ---- reflect for negative z ------------------------------------------
    // out = sign ? (SCALE - sigAbs) : sigAbs
    signal flip;
    flip <== abs.sign * (SCALE - 2 * sigAbs);
    out <== sigAbs + flip;

    // ---- enforce the range this template advertises ----------------------
    // Everything downstream depends on out being in [0, SCALE]: err = out -
    // y*SCALE is what bounds |gw| and hence the numerator of the weight-update
    // division, and DivConst pins down a unique (q, r) only while its numerator
    // cannot wrap the field.  That bound held for the honest witness -- the
    // one-hot selector determines out from a -- but it was *derived* from the
    // comparator chain being sound rather than constrained anywhere.  Two
    // Num2Bits make it true of every witness, for about forty constraints, and
    // turn the argument in the paper from a chain of reasoning into a check.
    component outLo = Num2Bits(20);      // 0 <= out < 2^20
    outLo.in <== out;
    component outHi = Num2Bits(20);      // out <= SCALE
    outHi.in <== SCALE - out;
}
